# Rideal Delivery API - Environment Configuration

# Server Settings
PORT=6030
NODE_ENV=development

# Database Settings
# Replace with your actual MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/rideal_delivery

# Security & CORS
# Comma-separated list of allowed frontend domains. 
# Do NOT leave empty in production. Include your deployed web URLs.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,https://admin.ridealdelivery.com,https://vendor.ridealdelivery.com

# JWT Secrets
# Generate secure random strings for these in production
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
# Token Expiration (e.g., 15m, 1h, 7d)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Socket.IO Settings (if needed for standalone/scale)
# Current implementation binds socket to the same PORT (6030)
SOCKET_PORT=6030

# External Services (For Production)
# Email/SMS Gateways (AWS SES, Twilio, etc)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass

# Payment Gateway (Razorpay/Stripe)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Map Services
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Push Notifications (Firebase FCM)
FIREBASE_SERVER_KEY=your_firebase_server_key
